# Set these in Supabase Edge Function Secrets. Never commit real values.
# Start with a Stripe sandbox/test key, not a live key.
STRIPE_SECRET_KEY=rk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PAYMENT_METHOD_CONFIG=pmc_replace_me
SITE_URL=https://siliconebodybrush2.pages.dev
# Optional extra storefront origins, comma-separated. No trailing paths.
ALLOWED_ORIGINS=https://silicone-body-brush.pages.dev,http://localhost:8081,http://127.0.0.1:8081
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by hosted Supabase.
